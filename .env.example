POSTGRES_DB=gold_agent
POSTGRES_USER=gold_agent
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
API_PORT=8000
APP_VERSION=0.1.0
DATABASE_URL=postgresql://gold_agent:change_me_postgres_password@postgres:5432/gold_agent
REDIS_URL=redis://:change_me_redis_password@redis:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000
AUTH_TOKEN_SECRET=change_me_auth_token_secret
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password
NEWS_FETCH_TIMEOUT_SECONDS=10
MARKET_SYNC_LOOKBACK_HOURS=5000
DEFAULT_NEWS_SOURCES_JSON=[{"name":"Reuters RSS","url":"https://feeds.reuters.com/reuters/businessNews","source_type":"rss","fetch_interval":300},{"name":"Kitco RSS","url":"https://www.kitco.com/rss/news","source_type":"rss","fetch_interval":300},{"name":"Investing Gold News RSS","url":"https://www.investing.com/rss/news_25.rss","source_type":"rss","fetch_interval":600},{"name":"Mining.com Gold RSS","url":"https://www.mining.com/commodity/gold/feed/","source_type":"rss","fetch_interval":900}]
MARKET_DATA_SOURCES_JSON=[{"name":"yahoo_finance","symbol_map":{"XAUUSD":"XAUUSD=X"}},{"name":"stooq_backup","symbol_map":{"XAUUSD":"XAUUSD"}}]
# ModelScope OpenAI-compatible GLM endpoint.
# ZhipuAI/GLM-5.1 is listed by ModelScope but returned empty choices in smoke tests.
LLM_ANALYSIS_ENABLED=false
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=ZhipuAI/GLM-5
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_ENDPOINT_URL=https://api-inference.modelscope.cn/v1/chat/completions
LLM_CACHE_ENABLED=true
LLM_BATCH_ENABLED=true
LLM_BATCH_MAX_ITEMS=5
LLM_DAILY_BUDGET_USD=1.0000
PHASE5_OBSERVATION_COLLECTION_ENABLED=false
PHASE5_EVIDENCE_WINDOW_STARTED=false
PHASE5_IBKR_PAPER_ORDER_EXECUTION_ENABLED=false
IBKR_PAPER_SANDBOX_MODE=paper
IBKR_PAPER_SANDBOX_HOST=
IBKR_PAPER_SANDBOX_PORT=
IBKR_PAPER_SANDBOX_CLIENT_ID=
IBKR_PAPER_SANDBOX_ACCOUNT_ID=
IBKR_PAPER_POSITION_CONFIRMATION_ATTEMPTS=3
IBKR_PAPER_POSITION_CONFIRMATION_SLEEP_SECONDS=1.0000
